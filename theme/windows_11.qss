QWidget {
    color: #1f1f1f;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    background-color: #f5f6f8;
}

QGroupBox {
    border: 1px solid #d6d9de;
    border-radius: 8px;
    margin-top: 10px;
    padding: 6px;
    background-color: #f5f6f8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    color: #5f6b7a;
    padding: 0 6px;
    background-color: transparent;
}

QPushButton {
    padding: 5px;
    border: 1px solid #c9ced6;
    border-radius: 8px;
    outline: none;
    background-color: #ffffff;
    color: #1f1f1f;
}

QPushButton:hover {
    border-color: #b8c7db;
    background-color: #f3f7fd;
}

QPushButton:focus {
    border-color: #4f9cff;
    outline: none;
}

QPushButton:hover:focus {
    border-color: #3d8ef7;
}

QPushButton:pressed:focus {
    border-color: #2f7fe8;
}

QPushButton:disabled {
    border-color: #d8dde4;
    color: #9aa3ad;
    background-color: #f1f3f5;
}

AnimatedButton {
    qproperty-normalColor: #ffffff;
    qproperty-hoverColor: #f3f7fd;
    qproperty-disabledColor: #f1f3f5;
    qproperty-hoverDuration: 160;
}

QPushButton#removeHistoryButton {
    padding: 0;
    border: none;
    border-radius: 0;
    font-size: 24px;
    color: #d94c4c;
    background: transparent;
}

QPushButton#removeHistoryButton:hover {
    color: #e25d5d;
    background: #eef4fb;
}

QComboBox {
    padding: 4px 8px;
    border: 1px solid #c9ced6;
    border-radius: 8px;
    outline: none;
    background-color: #ffffff;
    color: #1f1f1f;
}

QComboBox:focus {
    border-color: #4f9cff;
    outline: none;
}

AnimatedComboBox {
    qproperty-normalColor: #ffffff;
    qproperty-hoverColor: #f3f7fd;
    qproperty-disabledColor: #f1f3f5;
    qproperty-normalBorderColor: #c9ced6;
    qproperty-hoverBorderColor: #b8c7db;
    qproperty-disabledBorderColor: #d8dde4;
    qproperty-hoverDuration: 160;
}

AnimatedComboBox#algorithmCombo {
    qproperty-headerBackgroundColor: #f2f6fb;
    qproperty-headerTextColor: #5a6a7f;
    qproperty-headerDividerColor: #d7e2f0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 1px;
    border-left-color: #d4d9e1;
    border-left-style: solid;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    background-color: #f4f6f9;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c9ced6;
    border-radius: 8px;
    outline: none;
    color: #1f1f1f;
    selection-background-color: #e8f1fe;
    selection-color: #1f1f1f;
}

QComboBox QAbstractItemView::item {
    padding: 4px 5px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:focus {
    background-color: #e8f1fe;
    color: #1f1f1f;
}

QComboBox:disabled {
    color: #9aa3ad;
    background-color: #f1f3f5;
}

QLabel#historyLabel {
    padding: 8px 4px;
}

QLabel#historyLabel:hover {
    background-color: #eef4fb;
    border-radius: 6px;
}

ClickablePathLabel#dragAndDropLabel {
    padding: 10px;
    qproperty-normalColor: transparent;
    qproperty-hoverColor: #f3f7fd;
    qproperty-normalBorderColor: #d0d7e2;
    qproperty-hoverBorderColor: #4f9cff;
    qproperty-hoverDuration: 160;
}

AnimatedButton#historyButton {
    font-size: 17px;
}

AnimatedButton#infoButton {
    font-size: 20px;
}

AnimatedButton#clearButton {
    border: 1px solid #d94c4c;
    font-size: 30px;
    qproperty-normalColor: #ef5b5b;
    qproperty-hoverColor: #f26d6d;
    qproperty-disabledColor: #d6b1b1;
}

AnimatedButton#clearButton:hover {
    border-color: #e88d8d;
}

AnimatedButton#clearButton:disabled {
    border-color: #d2bcbc;
    color: #f3f3f3;
}

QProgressBar {
    background-color: #edf1f6;
    border: 1px solid #c9ced6;
    border-radius: 6px;
    text-align: center;
    color: #1f1f1f;
}

QMenu {
    border: 1px solid #d3d8e0;
    border-radius: 8px;
    background-color: #ffffff;
    outline: none;
    padding: 4px;
}

QMenu::separator {
    height: 1px;
    margin: 4px 6px;
    background-color: #e3e7ec;
}

QScrollBar:vertical {
    border: none;
    width: 12px;
    margin: 0px;
    background: #f1f3f6;
}

QScrollBar::handle:vertical {
    background: #c4ccd7;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #aeb8c6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-origin: margin;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QTabWidget::pane {
    border: 1px solid #d6d9de;
    border-radius: 8px;
    background-color: #f5f6f8;
}

QTabBar {
    outline: none;
}

QTabBar::tab {
    background-color: #eef2f6;
    border: 1px solid #d6d9de;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 12px;
    margin-right: 5px;
    color: #2a2a2a;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1f1f1f;
}

QTabBar::tab:hover:!selected {
    background-color: #f5f8fc;
    border-color: #b8c7db;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QSpinBox {
    padding: 4px 5px;
    background-color: #ffffff;
    border: 1px solid #c9ced6;
    border-radius: 8px;
    color: #1f1f1f;
    outline: none;
}

QSpinBox:hover {
    background-color: #f8fbff;
    border-color: #b8c7db;
}

QSpinBox:focus {
    background-color: #ffffff;
    border-color: #4f9cff;
    outline: none;
}

QSpinBox:hover:focus {
    background-color: #f8fbff;
    border-color: #3d8ef7;
}

QSpinBox:disabled {
    background-color: #f1f3f5;
    border-color: #d8dde4;
    color: #9aa3ad;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 24px;
}

QTableWidget {
    outline: none;
}

QTableWidget#algorithmInfoTable,
QTableWidget#algorithmDetailsTable {
    background-color: #ffffff;
    alternate-background-color: #f7f9fb;
    color: #1f1f1f;
    border: 1px solid #d6dbe3;
    gridline-color: #e4e8ee;
    selection-background-color: #e8f1fe;
    selection-color: #1f1f1f;
    outline: none;
}

QTableWidget#algorithmInfoTable::item,
QTableWidget#algorithmDetailsTable::item {
    padding: 6px;
    border: none;
}

QTableWidget#algorithmInfoTable::item:selected,
QTableWidget#algorithmDetailsTable::item:selected {
    background-color: #e8f1fe;
    color: #1f1f1f;
}

QTableWidget#algorithmInfoTable QHeaderView::section,
QTableWidget#algorithmDetailsTable QHeaderView::section {
    background-color: #f3f6fa;
    color: #334155;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid #dde3ea;
    border-bottom: 1px solid #d6dbe3;
    font-weight: 600;
}

QTableWidget#algorithmInfoTable QTableCornerButton::section,
QTableWidget#algorithmDetailsTable QTableCornerButton::section {
    background-color: #f3f6fa;
    border: none;
    border-right: 1px solid #dde3ea;
    border-bottom: 1px solid #d6dbe3;
}

QTableWidget#algorithmDetailsTable {
    font-size: 13px;
}

QTableWidget#algorithmDetailsTable::item {
    padding: 4px 6px;
}

QTableWidget#algorithmDetailsTable QHeaderView::section {
    font-size: 13px;
    padding: 5px 6px;
}

QLineEdit {
    padding: 4px 8px;
    background-color: #ffffff;
    border: 1px solid #c9ced6;
    border-radius: 8px;
    color: #1f1f1f;
    selection-background-color: #d8eaff;
    selection-color: #1f1f1f;
    outline: none;
}

QLineEdit:hover {
    background-color: #f8fbff;
    border-color: #b8c7db;
}

QLineEdit:focus {
    background-color: #ffffff;
    border-color: #4f9cff;
    outline: none;
}

QLineEdit:hover:focus {
    background-color: #f8fbff;
    border-color: #3d8ef7;
}

QLineEdit:disabled {
    background-color: #f1f3f5;
    border-color: #d8dde4;
    color: #9aa3ad;
}

QLineEdit[passwordState="match"] {
    border: 1px solid #2ca56a;
}

QLineEdit[passwordState="mismatch"] {
    border: 1px solid #d94c4c;
}

QLineEdit[passwordState="match"]:focus {
    border-color: #23935d;
}

QLineEdit[passwordState="mismatch"]:focus {
    border-color: #c63f3f;
}

QLabel#passwordMatchLabel[passwordState="match"] {
    color: #2ca56a;
}

QLabel#passwordMatchLabel[passwordState="mismatch"] {
    color: #d94c4c;
}

QProgressBar#passwordStrengthBar {
    background-color: #edf1f6;
    border: 1px solid #c9ced6;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#passwordStrengthBar::chunk {
    border-radius: 4px;
}

QProgressBar#passwordStrengthBar[strength="weak"]::chunk {
    background-color: #d94c4c;
}

QProgressBar#passwordStrengthBar[strength="medium"]::chunk {
    background-color: #e2912d;
}

QProgressBar#passwordStrengthBar[strength="good"]::chunk {
    background-color: #d0a91d;
}

QProgressBar#passwordStrengthBar[strength="strong"]::chunk {
    background-color: #2ca56a;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 12px;
    background-color: #ffffff;
    border: 1px solid #c9ced6;
    border-radius: 8px;
    color: #1f1f1f;
    font-weight: 600;
    outline: none;
}

QMessageBox QPushButton:hover {
    background-color: #f3f7fd;
    border-color: #b8c7db;
}

QMessageBox QPushButton:focus {
    border-color: #4f9cff;
    outline: none;
}

QMessageBox QPushButton:hover:focus {
    border-color: #3d8ef7;
}

QMessageBox QPushButton:pressed {
    background-color: #e8eef7;
    border-color: #9db9e3;
}

QMessageBox QPushButton:pressed:focus {
    border-color: #2f7fe8;
}

QMessageBox QPushButton:disabled {
    background-color: #f1f3f5;
    border-color: #d8dde4;
    color: #9aa3ad;
}

QCheckBox {
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 4px;
    outline: none;
    color: #1f1f1f;
}

QCheckBox:focus {
    border-color: #4f9cff;
}