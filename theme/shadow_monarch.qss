QWidget {
    color: #e7ecff;
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    background-color: #0b0e17;
}

QGroupBox {
    border: 1px solid #343d63;
    margin-top: 8px;
    padding: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    color: #8e7cff;
}

QPushButton {
    padding: 5px;
    border: 1px solid #343d63;
    border-radius: 5px;
    outline: none;
}

QPushButton:hover {
    border-color: #5968a5;
}

QPushButton:focus {
    border-color: #6eb7ff;
    outline: none;
}

QPushButton:hover:focus {
    border-color: #8cc9ff;
}

QPushButton:pressed:focus {
    border-color: #7665e8;
}

QPushButton:disabled {
    border-color: #2a3044;
    color: #596074;
}

AnimatedButton {
    qproperty-normalColor: #171d2e;
    qproperty-hoverColor: #212944;
    qproperty-disabledColor: #252a38;
    qproperty-hoverDuration: 160;
}

QPushButton#removeHistoryButton {
    padding: 0;
    border: none;
    border-radius: 0;
    font-size: 24px;
    color: #ff5575;
    background: transparent;
}

QPushButton#removeHistoryButton:hover {
    color: #ff7891;
    background: #212944;
}

QComboBox {
    padding: 4px 8px;
    border: 1px solid #343d63;
    border-radius: 5px;
    outline: none;
}

QComboBox:focus {
    border-color: #6eb7ff;
    outline: none;
}

AnimatedComboBox {
    qproperty-normalColor: #171d2e;
    qproperty-hoverColor: #212944;
    qproperty-disabledColor: #252a38;
    qproperty-normalBorderColor: #343d63;
    qproperty-hoverBorderColor: #5968a5;
    qproperty-disabledBorderColor: #30364a;
    qproperty-hoverDuration: 160;
}

AnimatedComboBox#algorithmCombo {
    qproperty-headerBackgroundColor: #101522;
    qproperty-headerTextColor: #9687ff;
    qproperty-headerDividerColor: #343d63;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 1px;
    border-left-color: #343d63;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #46548e;
}

QComboBox QAbstractItemView {
    background-color: #101522;
    border: 1px solid #343d63;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px 5px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:focus {
    background-color: #252d4b;
    color: #f0f4ff;
}

QComboBox:disabled {
    color: #596074;
}

QLabel#historyLabel {
    padding: 8px 4px;
}

QLabel#historyLabel:hover {
    background-color: #212944;
}

ClickablePathLabel#dragAndDropLabel {
    padding: 10px;
    qproperty-normalColor: transparent;
    qproperty-hoverColor: #171d2e;
    qproperty-normalBorderColor: #343d63;
    qproperty-hoverBorderColor: #5968a5;
    qproperty-hoverDuration: 160;
}

AnimatedButton#historyButton {
    font-size: 17px;
}

AnimatedButton#infoButton {
    font-size: 20px;
}

AnimatedButton#clearButton {
    border: 1px solid #d34462;
    font-size: 30px;
    qproperty-normalColor: #e44d6b;
    qproperty-hoverColor: #f06480;
    qproperty-disabledColor: #74394a;
}

AnimatedButton#clearButton:hover {
    border-color: #ff8ca0;
}

AnimatedButton#clearButton:disabled {
    border-color: #603140;
    color: #676d80;
}

QProgressBar {
    background-color: #171d2e;
    border: 1px solid #343d63;
}

QMenu {
    border: 1px solid #343d63;
    outline: none;
}

QMenu::separator {
    height: 1px;
    margin: 0;
    background-color: #343d63;
}

QScrollBar:vertical {
    border: none;
    width: 12px;
    margin: 0px;
    background: #101522;
}

QScrollBar::handle:vertical {
    background: #53629e;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #7969e8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-origin: margin;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QTabWidget::pane {
    border: 1px solid #343d63;
    background-color: #0b0e17;
}

QTabBar {
    outline: none;
}

QTabBar::tab {
    background-color: #111725;
    border: 1px solid #343d63;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 10px;
    margin-right: 5px;
    color: #dce4ff;
}

QTabBar::tab:selected {
    background-color: #202744;
    color: #9b8cff;
}

QTabBar::tab:hover:!selected {
    background-color: #1a2137;
    border-color: #5968a5;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QSpinBox {
    padding: 4px 5px;
    background-color: #171d2e;
    border: 1px solid #343d63;
    border-radius: 5px;
    color: #e7ecff;
    outline: none;
}

QSpinBox:hover {
    background-color: #212944;
    border-color: #5968a5;
}

QSpinBox:focus {
    background-color: #1c243b;
    border-color: #6eb7ff;
    outline: none;
}

QSpinBox:hover:focus {
    background-color: #212944;
    border-color: #8cc9ff;
}

QSpinBox:disabled {
    background-color: #252a38;
    border-color: #30364a;
    color: #596074;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 24px;
}

QTableWidget {
    outline: none;
}

QTableWidget#algorithmInfoTable,
QTableWidget#algorithmDetailsTable {
    background-color: #0e1320;
    alternate-background-color: #141a2b;
    color: #e7ecff;
    border: 1px solid #343d63;
    gridline-color: #293250;
    selection-background-color: #303b70;
    selection-color: #ffffff;
    outline: none;
}

QTableWidget#algorithmInfoTable::item,
QTableWidget#algorithmDetailsTable::item {
    padding: 6px;
    border: none;
}

QTableWidget#algorithmInfoTable::item:selected,
QTableWidget#algorithmDetailsTable::item:selected {
    background-color: #303b70;
    color: #ffffff;
}

QTableWidget#algorithmInfoTable QHeaderView::section,
QTableWidget#algorithmDetailsTable QHeaderView::section {
    background-color: #101522;
    color: #9b8cff;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid #293250;
    border-bottom: 1px solid #343d63;
    font-weight: 600;
}

QTableWidget#algorithmInfoTable QTableCornerButton::section,
QTableWidget#algorithmDetailsTable QTableCornerButton::section {
    background-color: #101522;
    border: none;
    border-right: 1px solid #293250;
    border-bottom: 1px solid #343d63;
}

QTableWidget#algorithmDetailsTable {
    font-size: 13px;
}

QTableWidget#algorithmDetailsTable::item {
    padding: 4px 6px;
}

QTableWidget#algorithmDetailsTable QHeaderView::section {
    font-size: 13px;
    padding: 5px 6px;
}

QLineEdit {
    padding: 4px 8px;
    background-color: #171d2e;
    border: 1px solid #343d63;
    border-radius: 5px;
    color: #e7ecff;
    selection-background-color: #394786;
    selection-color: white;
    outline: none;
}

QLineEdit:hover {
    background-color: #212944;
    border-color: #5968a5;
}

QLineEdit:focus {
    background-color: #1c243b;
    border-color: #6eb7ff;
    outline: none;
}

QLineEdit:hover:focus {
    background-color: #212944;
    border-color: #8cc9ff;
}

QLineEdit:disabled {
    background-color: #252a38;
    border-color: #30364a;
    color: #596074;
}

QLineEdit[passwordState="match"] {
    border: 1px solid #3ad58b;
}

QLineEdit[passwordState="mismatch"] {
    border: 1px solid #ff5575;
}

QLineEdit[passwordState="match"]:focus {
    border-color: #57eba2;
}

QLineEdit[passwordState="mismatch"]:focus {
    border-color: #ff7891;
}

QLabel#passwordMatchLabel[passwordState="match"] {
    color: #3ad58b;
}

QLabel#passwordMatchLabel[passwordState="mismatch"] {
    color: #ff5575;
}

QProgressBar#passwordStrengthBar {
    background-color: #171d2e;
    border: 1px solid #343d63;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#passwordStrengthBar::chunk {
    border-radius: 4px;
}

QProgressBar#passwordStrengthBar[strength="weak"]::chunk {
    background-color: #ff5575;
}

QProgressBar#passwordStrengthBar[strength="medium"]::chunk {
    background-color: #e18b3d;
}

QProgressBar#passwordStrengthBar[strength="good"]::chunk {
    background-color: #d6b83f;
}

QProgressBar#passwordStrengthBar[strength="strong"]::chunk {
    background-color: #3ad58b;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 12px;
    background-color: #171d2e;
    border: 1px solid #343d63;
    border-radius: 5px;
    color: #e7ecff;
    font-weight: 600;
    outline: none;
}

QMessageBox QPushButton:hover {
    background-color: #212944;
    border-color: #5968a5;
}

QMessageBox QPushButton:focus {
    border-color: #6eb7ff;
    outline: none;
}

QMessageBox QPushButton:hover:focus {
    border-color: #8cc9ff;
}

QMessageBox QPushButton:pressed {
    background-color: #181e32;
    border-color: #7665e8;
}

QMessageBox QPushButton:pressed:focus {
    border-color: #8e7cff;
}

QMessageBox QPushButton:disabled {
    background-color: #252a38;
    border-color: #30364a;
    color: #596074;
}

QCheckBox {
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 4px;
    outline: none;
}

QCheckBox:focus {
    border-color: #6eb7ff;
}