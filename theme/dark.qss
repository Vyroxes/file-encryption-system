QWidget {
    color: white;
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    background-color: #2e2e2e;
}

QGroupBox {
    border: 1px solid #707070;
    margin-top: 8px;
    padding: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    color: #707070;
}

QPushButton {
    padding: 5px;
    border: 1px solid #353535;
    border-radius: 5px;
    outline: none;
}

QPushButton:hover {
    border-color: #454545;
}

QPushButton:focus {
    border-color: #808080;
    outline: none;
}

QPushButton:hover:focus {
    border-color: #909090;
}

QPushButton:pressed:focus {
    border-color: #707070;
}

QPushButton:disabled {
    border-color: #555555;
    color: #666666;
}

AnimatedButton {
    qproperty-normalColor: #505050;
    qproperty-hoverColor: #606060;
    qproperty-disabledColor: #bbbbbb;
    qproperty-hoverDuration: 160;
}

QPushButton#removeHistoryButton {
    padding: 0;
    border: none;
    border-radius: 0;
    font-size: 24px;
    color: #ff5555;
    background: transparent;
}

QPushButton#removeHistoryButton:hover {
    color: #ff7777;
    background: #606060;
}

QComboBox {
    padding: 4px 8px;
    border: 1px solid #353535;
    border-radius: 5px;
    outline: none;
}

QComboBox:focus {
    border-color: #808080;
    outline: none;
}

AnimatedComboBox {
    qproperty-normalColor: #505050;
    qproperty-hoverColor: #606060;
    qproperty-disabledColor: #bbbbbb;
    qproperty-normalBorderColor: #353535;
    qproperty-hoverBorderColor: #454545;
    qproperty-disabledBorderColor: #555555;
    qproperty-hoverDuration: 160;
}

AnimatedComboBox#algorithmCombo {
    qproperty-headerBackgroundColor: #252525;
    qproperty-headerTextColor: #a8a8a8;
    qproperty-headerDividerColor: #505050;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 1px;
    border-left-color: darkgray;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #bbbbbb;
}

QComboBox QAbstractItemView {
    background-color: #2e2e2e;
    border: 1px solid #1f1f1f;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px 5px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:focus {
    background-color: #606060;
    color: white;
}

QComboBox:disabled {
    color: #666666;
}

QLabel#historyLabel {
    padding: 8px 4px;
}

QLabel#historyLabel:hover {
    background-color: #606060;
}

ClickablePathLabel#dragAndDropLabel {
    padding: 10px;
    qproperty-normalColor: transparent;
    qproperty-hoverColor: #505050;
    qproperty-normalBorderColor: #505050;
    qproperty-hoverBorderColor: #353535;
    qproperty-hoverDuration: 160;
}

AnimatedButton#historyButton {
    font-size: 17px;
}

AnimatedButton#infoButton {
    font-size: 20px;
}

AnimatedButton#clearButton {
    border: 1px solid #dd343c;
    font-size: 30px;
    qproperty-normalColor: #ff5555;
    qproperty-hoverColor: #ff7777;
    qproperty-disabledColor: #a94444;
}

AnimatedButton#clearButton:hover {
    border-color: #e68e8b;
}

AnimatedButton#clearButton:disabled {
    border-color: #883838;
    color: #bbbbbb;
}

QProgressBar {
    background-color: #505050;
    border: 1px solid #353535;
}

QMenu {
    border: 1px solid #707070;
    outline: none;
}

QMenu::separator {
    height: 1px;
    margin: 0;
    background-color: #707070;
}

QScrollBar:vertical {
    border: none;
    width: 12px;
    margin: 0px;
    background: #252525;
}

QScrollBar::handle:vertical {
    background: #909090;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #707070;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-origin: margin;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QTabWidget::pane {
    border: 1px solid #707070;
    background-color: #2e2e2e;
}

QTabBar {
    outline: none;
}

QTabBar::tab {
    background-color: #2e2e2e;
    border: 1px solid #707070;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 10px;
    margin-right: 5px;
    color: white;
}

QTabBar::tab:selected {
    background-color: #505050;
    color: white;
}

QTabBar::tab:hover:!selected {
    background-color: #404040;
    border-color: #808080;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QSpinBox {
    padding: 4px 5px;
    background-color: #505050;
    border: 1px solid #353535;
    border-radius: 5px;
    color: white;
    outline: none;
}

QSpinBox:hover {
    background-color: #606060;
    border-color: #454545;
}

QSpinBox:focus {
    background-color: #565656;
    border-color: #808080;
    outline: none;
}

QSpinBox:hover:focus {
    background-color: #606060;
    border-color: #909090;
}

QSpinBox:disabled {
    background-color: #bbbbbb;
    border-color: #555555;
    color: #666666;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 24px;
}

QTableWidget {
    outline: none;
}

QTableWidget#algorithmInfoTable,
QTableWidget#algorithmDetailsTable {
    background-color: #2b2b2b;
    alternate-background-color: #333333;
    color: #f2f2f2;
    border: 1px solid #555555;
    gridline-color: #4a4a4a;
    selection-background-color: #505050;
    selection-color: #ffffff;
    outline: none;
}

QTableWidget#algorithmInfoTable::item,
QTableWidget#algorithmDetailsTable::item {
    padding: 6px;
    border: none;
}

QTableWidget#algorithmInfoTable::item:selected,
QTableWidget#algorithmDetailsTable::item:selected {
    background-color: #505050;
    color: #ffffff;
}

QTableWidget#algorithmInfoTable QHeaderView::section,
QTableWidget#algorithmDetailsTable QHeaderView::section {
    background-color: #242424;
    color: #f2f2f2;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid #4a4a4a;
    border-bottom: 1px solid #555555;
    font-weight: 600;
}

QTableWidget#algorithmInfoTable QTableCornerButton::section,
QTableWidget#algorithmDetailsTable QTableCornerButton::section {
    background-color: #242424;
    border: none;
    border-right: 1px solid #4a4a4a;
    border-bottom: 1px solid #555555;
}

QTableWidget#algorithmDetailsTable {
    font-size: 13px;
}

QTableWidget#algorithmDetailsTable::item {
    padding: 4px 6px;
}

QTableWidget#algorithmDetailsTable QHeaderView::section {
    font-size: 13px;
    padding: 5px 6px;
}

QLineEdit {
    padding: 4px 8px;
    background-color: #505050;
    border: 1px solid #353535;
    border-radius: 5px;
    color: white;
    selection-background-color: #707070;
    selection-color: white;
    outline: none;
}

QLineEdit:hover {
    background-color: #606060;
    border-color: #454545;
}

QLineEdit:focus {
    background-color: #565656;
    border-color: #808080;
    outline: none;
}

QLineEdit:hover:focus {
    background-color: #606060;
    border-color: #909090;
}

QLineEdit:disabled {
    background-color: #bbbbbb;
    border-color: #555555;
    color: #666666;
}

QLineEdit[passwordState="match"] {
    border: 1px solid #16a34a;
}

QLineEdit[passwordState="mismatch"] {
    border: 1px solid #dd343c;
}

QLineEdit[passwordState="match"]:focus {
    border-color: #22c55e;
}

QLineEdit[passwordState="mismatch"]:focus {
    border-color: #ef4444;
}

QLabel#passwordMatchLabel[passwordState="match"] {
    color: #16a34a;
}

QLabel#passwordMatchLabel[passwordState="mismatch"] {
    color: #dd343c;
}

QProgressBar#passwordStrengthBar {
    background-color: #505050;
    border: 1px solid #353535;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#passwordStrengthBar::chunk {
    border-radius: 4px;
}

QProgressBar#passwordStrengthBar[strength="weak"]::chunk {
    background-color: #dd343c;
}

QProgressBar#passwordStrengthBar[strength="medium"]::chunk {
    background-color: #d97706;
}

QProgressBar#passwordStrengthBar[strength="good"]::chunk {
    background-color: #ca8a04;
}

QProgressBar#passwordStrengthBar[strength="strong"]::chunk {
    background-color: #16a34a;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 12px;
    background-color: #505050;
    border: 1px solid #353535;
    border-radius: 5px;
    color: white;
    font-weight: 600;
    outline: none;
}

QMessageBox QPushButton:hover {
    background-color: #606060;
    border-color: #454545;
}

QMessageBox QPushButton:focus {
    border-color: #808080;
    outline: none;
}

QMessageBox QPushButton:hover:focus {
    border-color: #909090;
}

QMessageBox QPushButton:pressed {
    background-color: #454545;
    border-color: #303030;
}

QMessageBox QPushButton:pressed:focus {
    border-color: #707070;
}

QMessageBox QPushButton:disabled {
    background-color: #bbbbbb;
    border-color: #555555;
    color: #666666;
}

QCheckBox {
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 4px;
    outline: none;
}

QCheckBox:focus {
    border-color: #808080;
}