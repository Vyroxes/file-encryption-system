QWidget {
    color: #16343a;
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    background-color: #eaf7f7;
}

QGroupBox {
    border: 1px solid #82c7c7;
    margin-top: 8px;
    padding: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    color: #368f94;
}

QPushButton {
    padding: 5px;
    border: 1px solid #82c7c7;
    border-radius: 5px;
    outline: none;
}

QPushButton:hover {
    border-color: #4daeb3;
}

QPushButton:focus {
    border-color: #218d9d;
    outline: none;
}

QPushButton:hover:focus {
    border-color: #167684;
}

QPushButton:pressed:focus {
    border-color: #136572;
}

QPushButton:disabled {
    border-color: #bfd8d8;
    color: #829c9f;
}

AnimatedButton {
    qproperty-normalColor: #d5eeee;
    qproperty-hoverColor: #c4e6e6;
    qproperty-disabledColor: #dce8e8;
    qproperty-hoverDuration: 160;
}

QPushButton#removeHistoryButton {
    padding: 0;
    border: none;
    border-radius: 0;
    font-size: 24px;
    color: #df5362;
    background: transparent;
}

QPushButton#removeHistoryButton:hover {
    color: #f06d79;
    background: #c4e6e6;
}

QComboBox {
    padding: 4px 8px;
    border: 1px solid #82c7c7;
    border-radius: 5px;
    outline: none;
}

QComboBox:focus {
    border-color: #218d9d;
    outline: none;
}

AnimatedComboBox {
    qproperty-normalColor: #d5eeee;
    qproperty-hoverColor: #c4e6e6;
    qproperty-disabledColor: #dce8e8;
    qproperty-normalBorderColor: #82c7c7;
    qproperty-hoverBorderColor: #4daeb3;
    qproperty-disabledBorderColor: #b8cece;
    qproperty-hoverDuration: 160;
}

AnimatedComboBox#algorithmCombo {
    qproperty-headerBackgroundColor: #d8f0f0;
    qproperty-headerTextColor: #287d83;
    qproperty-headerDividerColor: #82c7c7;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 1px;
    border-left-color: #82c7c7;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #a9dddd;
}

QComboBox QAbstractItemView {
    background-color: #f2fbfb;
    border: 1px solid #82c7c7;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px 5px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:focus {
    background-color: #c4e6e6;
    color: #16343a;
}

QComboBox:disabled {
    color: #829c9f;
}

QLabel#historyLabel {
    padding: 8px 4px;
}

QLabel#historyLabel:hover {
    background-color: #c4e6e6;
}

ClickablePathLabel#dragAndDropLabel {
    padding: 10px;
    qproperty-normalColor: transparent;
    qproperty-hoverColor: #d5eeee;
    qproperty-normalBorderColor: #9ed4d4;
    qproperty-hoverBorderColor: #4daeb3;
    qproperty-hoverDuration: 160;
}

AnimatedButton#historyButton {
    font-size: 17px;
}

AnimatedButton#infoButton {
    font-size: 20px;
}

AnimatedButton#clearButton {
    border: 1px solid #d84b59;
    font-size: 30px;
    qproperty-normalColor: #eb6571;
    qproperty-hoverColor: #f47e87;
    qproperty-disabledColor: #c7a2a5;
}

AnimatedButton#clearButton:hover {
    border-color: #e88b93;
}

AnimatedButton#clearButton:disabled {
    border-color: #c7a2a5;
    color: #9daeb0;
}

QProgressBar {
    background-color: #d5eeee;
    border: 1px solid #82c7c7;
}

QMenu {
    border: 1px solid #82c7c7;
    outline: none;
}

QMenu::separator {
    height: 1px;
    margin: 0;
    background-color: #82c7c7;
}

QScrollBar:vertical {
    border: none;
    width: 12px;
    margin: 0px;
    background: #d7eeee;
}

QScrollBar::handle:vertical {
    background: #75bfc1;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #459ea3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-origin: margin;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QTabWidget::pane {
    border: 1px solid #82c7c7;
    background-color: #eaf7f7;
}

QTabBar {
    outline: none;
}

QTabBar::tab {
    background-color: #d5eeee;
    border: 1px solid #82c7c7;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 10px;
    margin-right: 5px;
    color: #16343a;
}

QTabBar::tab:selected {
    background-color: #eaf7f7;
    color: #1c747c;
}

QTabBar::tab:hover:!selected {
    background-color: #c4e6e6;
    border-color: #4daeb3;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QSpinBox {
    padding: 4px 5px;
    background-color: #d5eeee;
    border: 1px solid #82c7c7;
    border-radius: 5px;
    color: #16343a;
    outline: none;
}

QSpinBox:hover {
    background-color: #c4e6e6;
    border-color: #4daeb3;
}

QSpinBox:focus {
    background-color: #cdeaea;
    border-color: #218d9d;
    outline: none;
}

QSpinBox:hover:focus {
    background-color: #c4e6e6;
    border-color: #167684;
}

QSpinBox:disabled {
    background-color: #dce8e8;
    border-color: #b8cece;
    color: #829c9f;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 24px;
}

QTableWidget {
    outline: none;
}

QTableWidget#algorithmInfoTable,
QTableWidget#algorithmDetailsTable {
    background-color: #f8ffff;
    alternate-background-color: #edf9f9;
    color: #16343a;
    border: 1px solid #a4d1d1;
    gridline-color: #c3dfdf;
    selection-background-color: #bde2e2;
    selection-color: #16343a;
    outline: none;
}

QTableWidget#algorithmInfoTable::item,
QTableWidget#algorithmDetailsTable::item {
    padding: 6px;
    border: none;
}

QTableWidget#algorithmInfoTable::item:selected,
QTableWidget#algorithmDetailsTable::item:selected {
    background-color: #bde2e2;
    color: #16343a;
}

QTableWidget#algorithmInfoTable QHeaderView::section,
QTableWidget#algorithmDetailsTable QHeaderView::section {
    background-color: #d8f0f0;
    color: #216d73;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid #a4d1d1;
    border-bottom: 1px solid #a4d1d1;
    font-weight: 600;
}

QTableWidget#algorithmInfoTable QTableCornerButton::section,
QTableWidget#algorithmDetailsTable QTableCornerButton::section {
    background-color: #d8f0f0;
    border: none;
    border-right: 1px solid #a4d1d1;
    border-bottom: 1px solid #a4d1d1;
}

QTableWidget#algorithmDetailsTable {
    font-size: 13px;
}

QTableWidget#algorithmDetailsTable::item {
    padding: 4px 6px;
}

QTableWidget#algorithmDetailsTable QHeaderView::section {
    font-size: 13px;
    padding: 5px 6px;
}

QLineEdit {
    padding: 4px 8px;
    background-color: #d5eeee;
    border: 1px solid #82c7c7;
    border-radius: 5px;
    color: #16343a;
    selection-background-color: #9ed7d7;
    selection-color: #102d31;
    outline: none;
}

QLineEdit:hover {
    background-color: #c4e6e6;
    border-color: #4daeb3;
}

QLineEdit:focus {
    background-color: #cdeaea;
    border-color: #218d9d;
    outline: none;
}

QLineEdit:hover:focus {
    background-color: #c4e6e6;
    border-color: #167684;
}

QLineEdit:disabled {
    background-color: #dce8e8;
    border-color: #b8cece;
    color: #829c9f;
}

QLineEdit[passwordState="match"] {
    border: 1px solid #259c66;
}

QLineEdit[passwordState="mismatch"] {
    border: 1px solid #d94b59;
}

QLineEdit[passwordState="match"]:focus {
    border-color: #168f58;
}

QLineEdit[passwordState="mismatch"]:focus {
    border-color: #c33746;
}

QLabel#passwordMatchLabel[passwordState="match"] {
    color: #168f58;
}

QLabel#passwordMatchLabel[passwordState="mismatch"] {
    color: #c33746;
}

QProgressBar#passwordStrengthBar {
    background-color: #d5eeee;
    border: 1px solid #82c7c7;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#passwordStrengthBar::chunk {
    border-radius: 4px;
}

QProgressBar#passwordStrengthBar[strength="weak"]::chunk {
    background-color: #d94b59;
}

QProgressBar#passwordStrengthBar[strength="medium"]::chunk {
    background-color: #d98a23;
}

QProgressBar#passwordStrengthBar[strength="good"]::chunk {
    background-color: #b4a514;
}

QProgressBar#passwordStrengthBar[strength="strong"]::chunk {
    background-color: #259c66;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 12px;
    background-color: #d5eeee;
    border: 1px solid #82c7c7;
    border-radius: 5px;
    color: #16343a;
    font-weight: 600;
    outline: none;
}

QMessageBox QPushButton:hover {
    background-color: #c4e6e6;
    border-color: #4daeb3;
}

QMessageBox QPushButton:focus {
    border-color: #218d9d;
    outline: none;
}

QMessageBox QPushButton:hover:focus {
    border-color: #167684;
}

QMessageBox QPushButton:pressed {
    background-color: #aedada;
    border-color: #167684;
}

QMessageBox QPushButton:pressed:focus {
    border-color: #136572;
}

QMessageBox QPushButton:disabled {
    background-color: #dce8e8;
    border-color: #b8cece;
    color: #829c9f;
}

QCheckBox {
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 4px;
    outline: none;
}

QCheckBox:focus {
    border-color: #218d9d;
}