QWidget {
    color: black;
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    background-color: #efefef;
}

QGroupBox {
    border: 1px solid #a6a6a6;
    margin-top: 8px;
    padding: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    color: #707070;
}

QPushButton {
    padding: 5px;
    border: 1px solid #a6a6a6;
    border-radius: 5px;
}

AnimatedButton {
    qproperty-normalColor: #dedede;
    qproperty-hoverColor: #d1d1d1;
    qproperty-disabledColor: #bbbbbb;
    qproperty-hoverDuration: 160;
}

QPushButton:hover {
    border-color: #858585;
}

QPushButton:disabled {
    border-color: #a6a6a6;
    color: #777777;
}

QComboBox {
    padding: 4px 8px;
    border-radius: 5px;
}

AnimatedComboBox {
    qproperty-normalColor: #dedede;
    qproperty-hoverColor: #d1d1d1;
    qproperty-disabledColor: #bbbbbb;
    qproperty-normalBorderColor: #a6a6a6;
    qproperty-hoverBorderColor: #858585;
    qproperty-disabledBorderColor: #999999;
    qproperty-hoverDuration: 160;
}

AnimatedComboBox#algorithmCombo {
    qproperty-headerBackgroundColor: #e2e2e2;
    qproperty-headerTextColor: #555555;
    qproperty-headerDividerColor: #b5b5b5;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 1px;
    border-left-color: #a6a6a6;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #bbbbbb;
}

QComboBox QAbstractItemView {
    background-color: #efefef;
    border: 1px solid #a6a6a6;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px 5px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:focus {
    background-color: #d1d1d1;
    color: black;
}

QComboBox:disabled {
    color: #666666;
}

QLabel#historyLabel {
    padding: 8px 4px;
}

QLabel#historyLabel:hover {
    background-color: #d1d1d1;
}

ClickablePathLabel#dragAndDropLabel {
    padding: 10px;
    qproperty-normalColor: transparent;
    qproperty-hoverColor: #dedede;
    qproperty-normalBorderColor: #dedede;
    qproperty-hoverBorderColor: #a6a6a6;
    qproperty-hoverDuration: 160;
}

AnimatedButton#historyButton {
    font-size: 17px;
}

AnimatedButton#infoButton {
    font-size: 20px;
}

AnimatedButton#clearButton {
    border: 1px solid #dd343c;
    font-size: 30px;
    qproperty-normalColor: #ff5555;
    qproperty-hoverColor: #ff7777;
    qproperty-disabledColor: #a94444;
}

AnimatedButton#clearButton:hover {
    border-color: #e68e8b;
}

AnimatedButton#clearButton:disabled {
    border-color: #883838;
    color: #bbbbbb;
}

QProgressBar {
    background-color: #dedede;
    border: 1px solid #a6a6a6;
}

QPushButton#removeHistoryButton {
    padding: 0;
    border: none;
    border-radius: 0;
    font-size: 24px;
    color: #ff5555;
    background: transparent;
}

QPushButton#removeHistoryButton:hover {
    color: #ff7777;
    background: #d1d1d1;
}

QMenu {
    border: 1px solid #a6a6a6;
}

QMenu::separator {
    height: 1px;
    margin: 0;
    background-color: #a6a6a6;
}

QScrollBar:vertical {
    border: none;
    width: 12px;
    margin: 0px;
    background: #e0e0e0;
}

QScrollBar::handle:vertical {
    background: #b5b5b5;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #9e9e9e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-origin: margin;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QTabWidget::pane {
    border: 1px solid #a6a6a6;
    background-color: #efefef;
}

QTabBar::tab {
    background-color: #d9d9d9;
    border: 1px solid #a6a6a6;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 10px;
    margin-right: 5px;
    color: black;
}

QTabBar::tab:selected {
    background-color: #efefef;
    color: black;
}

QTabBar::tab:hover:!selected {
    background-color: #d1d1d1;
    border-color: #858585;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QSpinBox,
QSpinBox:focus {
    padding: 4px 5px;
    background-color: #dedede;
    border: 1px solid #a6a6a6;
    border-radius: 5px;
    color: black;
}

QSpinBox:hover {
    background-color: #d1d1d1;
    border: 1px solid #858585;
}

QSpinBox:disabled {
    background-color: #bbbbbb;
    border: 1px solid #999999;
    color: #666666;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 24px;
}

QTableWidget#algorithmInfoTable,
QTableWidget#algorithmDetailsTable {
    background-color: #ffffff;
    alternate-background-color: #f3f3f3;
    color: #202020;
    border: 1px solid #c8c8c8;
    gridline-color: #d7d7d7;
    selection-background-color: #d1d1d1;
    selection-color: #202020;
    outline: none;
}

QTableWidget#algorithmInfoTable::item,
QTableWidget#algorithmDetailsTable::item {
    padding: 6px;
    border: none;
}

QTableWidget#algorithmInfoTable::item:selected,
QTableWidget#algorithmDetailsTable::item:selected {
    background-color: #d1d1d1;
    color: #202020;
}

QTableWidget#algorithmInfoTable QHeaderView::section,
QTableWidget#algorithmDetailsTable QHeaderView::section {
    background-color: #e9e9e9;
    color: #202020;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid #c8c8c8;
    border-bottom: 1px solid #c8c8c8;
    font-weight: 600;
}

QTableWidget#algorithmInfoTable QTableCornerButton::section,
QTableWidget#algorithmDetailsTable QTableCornerButton::section {
    background-color: #e9e9e9;
    border: none;
    border-right: 1px solid #c8c8c8;
    border-bottom: 1px solid #c8c8c8;
}

QTableWidget#algorithmDetailsTable {
    font-size: 13px;
}

QTableWidget#algorithmDetailsTable::item {
    padding: 4px 6px;
}

QTableWidget#algorithmDetailsTable QHeaderView::section {
    font-size: 13px;
    padding: 5px 6px;
}